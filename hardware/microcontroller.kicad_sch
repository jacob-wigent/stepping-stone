	(text "FOLLOW ST USB APPNOTE"
		(exclude_from_sim no)
		(at 101.6 34.29 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.1588)
				(color 194 0 0 1)
			)
			(justify left)
			(href "https://www.st.com/resource/en/application_note/an4879-introduction-to-usb-hardware-and-pcb-guidelines-using-stm32-mcus-stmicroelectronics.pdf")
		)
		(uuid "75c9c576-94a8-4dac-aa69-1254af8ae975")
	)
	(text "Scales max 30.3V down to 3.3V VDDA, safely\ncovering the 29V TMC2209 limit.\nNode features a Thevenin equivalent resistance\n(Req) of 1.96kΩ [(18k × 2.2k) / (18k + 2.2k)].\nPaired with a 10nF capacitor to form an 8.1kHz\nlow-pass filter corner (Tau = 19.6µs, Settling = 98µs).\nThis blocks 20kHz+ TMC2209 chopper noise while \nreacting fast enough (<100µs) to capture emergency\nback-EMF spikes.\n\nRoute directly to an STM32G4 OPAMP configured as a \n Voltage Follower. Its high input impedance prevents\ndivider loading, and its near-zero output impedance\nguarantees fast, precise ADC sampling."
		(exclude_from_sim no)
		(at 217.17 83.82 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify right)
		)
		(uuid "b54ffad9-c132-44e1-b9e2-94dba56ae086")
	)
	(text "User LEDs/Buttons"
		(exclude_from_sim no)
		(at 162.56 105.41 0)
		(effects
			(font
				(size 1.905 1.905)
			)
			(justify left)
		)
		(uuid "bf0b4d6c-ec3b-483e-95af-fb6e2674d4f7")
	)
	(text "Programming/System"
		(exclude_from_sim no)
		(at 222.25 17.78 0)
